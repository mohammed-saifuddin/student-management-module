<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="student_management_view_list" model="ir.ui.view">
        <field name="name">student.management.list</field>
        <field name="model">student.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="roll_number"/>
                <field name="course"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="admission_date"/>
                <field name="age"/>
                <field name="date_of_birth"/>
            </list>
        </field>
    </record>
<record id="student_course_view_list" model="ir.ui.view">
    <field name="name">student.course.list</field>
    <field name="model">student.course</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="code"/>
            <field name="duration"/>
        </list>
    </field>
</record>

<record id="student_course_view_form" model="ir.ui.view">
    <field name="name">student.course.form</field>
    <field name="model">student.course</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="duration"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="student_course_action" model="ir.actions.act_window">
    <field name="name">Courses</field>
    <field name="res_model">student.course</field>
    <field name="view_mode">list,form</field>
</record>

<record id="student_department_view_list" model="ir.ui.view">
    <field name="name">student.department.list</field>
    <field name="model">student.department</field>
    <field name="arch" type="xml">
        <list>
            <field name="name"/>
            <field name="course"/>
            <field name="roll_number"/>
        </list>
    </field>
</record>
<record id="student_department_view_form" model="ir.ui.view">
<field name="name">student.department.form</field>
<field name="model">student.department</field>
<field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="course"/>
                    <field name="roll_number"/>
                    
                </group>
            </sheet>
        </form>
    </field>
</record>
<record id="student_department_action" model="ir.actions.act_window">
    <field name="name">Departments</field>
    <field name="res_model">student.department</field>
    <field name="view_mode">list,form</field>
</record>

    <record id="student_management_view_form" model="ir.ui.view">
        <field name="name">student.management.form</field>
        <field name="model">student.management</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="roll_number"/>
                            <field name="course"/>
                            <field name="age"/>
                            <field name="date_of_birth"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="admission_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_management_action" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.management</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="student_management_root"
          name="Student Management"
          sequence="10"/>

<menuitem id="student_management_students"
          name="Students"
          parent="student_management_root"
          action="student_management_action"
          sequence="1"/>

<menuitem id="student_management_courses"
          name="Courses"
          parent="student_management_root"
          action="student_course_action"
          sequence="2"/>

<menuitem id="student_management_departments"
          name="Departments"
          parent="student_management_root"
          action="student_department_action"
          sequence="3"/>

<menuitem id="student_management_admissions"
          name="Admissions"
          parent="student_management_root"
          sequence="4"/>
</odoo>